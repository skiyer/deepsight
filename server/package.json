{
  "name": "deepsight-server",
  "version": "2026.1.31",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --minify --external:dotenv --external:hono --external:@anthropic-ai/claude-agent-sdk --external:@hono/node-server",
    "start:prod": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.20",
    "@hono/node-server": "^1.19.9",
    "dotenv": "^16.6.1",
    "hono": "^4.11.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.6",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
