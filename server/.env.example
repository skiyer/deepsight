# DeepSight Server Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API authentication token
ANTHROPIC_AUTH_TOKEN=your_token_here

# Anthropic API base URL (optional, for custom endpoints)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Server port (optional, default: 3000)
PORT=3000

# Debug options
# Set to "true" to enable detailed prompt logging in server console
DEBUG_PROMPT=false
